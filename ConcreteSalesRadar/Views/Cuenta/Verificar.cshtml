@model VerificarCodigoViewModel
@{
    ViewData["Title"] = L["Ver_Title"].Value;
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>@L["Ver_Title"]</h1>
        <p class="sub">@L["Ver_Sub1"] <b>@Model.Correo</b>.</p>

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }
        @if (TempData["CodigoDev"] != null)
        {
            <div class="code-dev">
                @L["Ver_Dev"] <b>@TempData["CodigoDev"]</b>
            </div>
        }

        <form asp-action="Verificar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UsuarioId" />
            <input type="hidden" asp-for="Correo" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>@L["F_Codigo"]</label>
                <input asp-for="Codigo" class="form-control" maxlength="6" inputmode="numeric"
                       style="font-size:22px;letter-spacing:8px;text-align:center" autofocus />
                <span asp-validation-for="Codigo"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">@L["Ver_Submit"]</button>
        </form>

        <form asp-action="ReenviarCodigo" method="post" style="margin-top:14px;text-align:center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="usuarioId" value="@Model.UsuarioId" />
            <button type="submit" class="btn btn-ghost btn-sm">@L["Ver_Resend"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
