@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Iniciar sesión</h1>
        <p class="sub">Accede a tu dashboard de prospección de obras.</p>

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">@TempData["Exito"]</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Correo"></label>
                <input asp-for="Correo" class="form-control" type="email" autofocus />
                <span asp-validation-for="Correo"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="form-group">
                <label style="font-weight:600;font-size:13px">
                    <input type="checkbox" asp-for="Recordarme" /> Recordarme
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Entrar</button>
        </form>

        <p class="sub" style="margin-top:18px;text-align:center">
            ¿No tienes cuenta? <a asp-action="Registro">Regístrate</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
