@model RegistroViewModel
@{
    ViewData["Title"] = L["Reg_Title"].Value;
    var planes = ViewBag.Planes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<div class="auth-wrap">
    <div class="auth-card wide">
        <h1>@L["Reg_Title"]</h1>
        <p class="sub">@L["Reg_Sub"]</p>

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }

        <form asp-action="Registro" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">
                <div class="form-group">
                    <label>@L["F_Nombre"]</label>
                    <input asp-for="Nombre" class="form-control" maxlength="50" />
                    <span asp-validation-for="Nombre"></span>
                </div>
                <div class="form-group">
                    <label>@L["F_Apellido"]</label>
                    <input asp-for="Apellido" class="form-control" maxlength="50" />
                    <span asp-validation-for="Apellido"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>@L["F_Compania"]</label>
                    <input asp-for="Compania" class="form-control" maxlength="50" />
                    <span asp-validation-for="Compania"></span>
                </div>
                <div class="form-group">
                    <label>@L["F_Telefono"]</label>
                    <input asp-for="Telefono" class="form-control" maxlength="50" />
                    <span asp-validation-for="Telefono"></span>
                </div>
            </div>

            <div class="form-group">
                <label>@L["F_Correo"]</label>
                <input asp-for="Correo" class="form-control" type="email" maxlength="100" />
                <span asp-validation-for="Correo"></span>
            </div>

            <div class="form-group">
                <label>@L["F_Plan"]</label>
                <select asp-for="MembresiaId" class="form-control" asp-items="planes">
                    <option value="">@L["Reg_SelectPlan"]</option>
                </select>
                <span asp-validation-for="MembresiaId"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>@L["F_Password"]</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="form-group">
                    <label>@L["F_ConfirmPassword"]</label>
                    <input asp-for="ConfirmarPassword" class="form-control" />
                    <span asp-validation-for="ConfirmarPassword"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block">@L["Reg_Submit"]</button>
        </form>

        <p class="sub" style="margin-top:18px;text-align:center">
            @L["Reg_Have"] <a asp-action="Login">@L["Reg_SignIn"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
