@model Membresia
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nueva membresía" : "Editar membresía";
}
<div class="app-main">
    <div class="container-xl">
        <h1 class="page-title">@(esNuevo ? "Nueva membresía" : "Editar membresía")</h1>

        <div class="card" style="max-width:720px">
            <form asp-action="GuardarMembresia" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Nombre"></label>
                        <input asp-for="Nombre" class="form-control" maxlength="50" />
                        <span asp-validation-for="Nombre"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Orden">Orden</label>
                        <input asp-for="Orden" type="number" class="form-control" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="PrecioMensual">Precio mensual ($) — 0 = contactar ventas</label>
                        <input asp-for="PrecioMensual" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="MaxUsuarios">Máx. usuarios</label>
                        <input asp-for="MaxUsuarios" type="number" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Descripcion">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" maxlength="250" />
                </div>

                <div class="form-group">
                    <label asp-for="Caracteristicas">Características (una por línea)</label>
                    <textarea asp-for="Caracteristicas" class="form-control" rows="7" maxlength="1000"></textarea>
                </div>

                <div style="display:flex;gap:18px;margin-bottom:16px">
                    <label style="font-weight:600"><input type="checkbox" asp-for="EsPopular" /> Más popular</label>
                    <label style="font-weight:600"><input type="checkbox" asp-for="Activa" /> Activa</label>
                </div>

                <div style="display:flex;gap:10px">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a class="btn btn-ghost" asp-action="Membresias">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
