@{
    ViewData["Title"] = L["Adm_Title"].Value;
}
<div class="app-main">
    <div class="container-xl">
        <h1 class="page-title">@L["Adm_Title"]</h1>
        <p class="page-sub">@L["Adm_Sub"]</p>

        <div class="grid2">
            <div class="card">
                <h3 class="card-title">👥 @L["Adm_UsersCard"]</h3>
                <p class="muted">@L["Adm_UsersCardDesc"]</p>
                <a class="btn btn-primary" asp-action="Usuarios">@L["Adm_UsersBtn"]</a>
            </div>
            <div class="card">
                <h3 class="card-title">💳 @L["Adm_PlansCard"]</h3>
                <p class="muted">@L["Adm_PlansCardDesc"]</p>
                <a class="btn btn-primary" asp-action="Membresias">@L["Adm_PlansBtn"]</a>
            </div>
        </div>
    </div>
</div>
