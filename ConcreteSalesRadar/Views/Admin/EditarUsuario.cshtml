@model Usuario
@{
    ViewData["Title"] = L["Adm_EditUserTitle"].Value;
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var membresias = ViewBag.Membresias as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}
<div class="app-main">
    <div class="container-xl">
        <h1 class="page-title">@L["Adm_EditUserTitle"]</h1>
        <p class="page-sub">@Model.Correo</p>

        <div class="card" style="max-width:720px">
            <form asp-action="EditarUsuario" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Correo" />
                <input type="hidden" asp-for="PasswordHash" />
                <input type="hidden" asp-for="FechaRegistro" />

                <div class="form-row">
                    <div class="form-group">
                        <label>@L["F_Nombre"]</label>
                        <input asp-for="Nombre" class="form-control" maxlength="50" />
                        <span asp-validation-for="Nombre"></span>
                    </div>
                    <div class="form-group">
                        <label>@L["F_Apellido"]</label>
                        <input asp-for="Apellido" class="form-control" maxlength="50" />
                        <span asp-validation-for="Apellido"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>@L["F_Compania"]</label>
                        <input asp-for="Compania" class="form-control" maxlength="50" />
                    </div>
                    <div class="form-group">
                        <label>@L["Adm_Col_Phone"]</label>
                        <input asp-for="Telefono" class="form-control" maxlength="50" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>@L["Adm_Role"]</label>
                        <select asp-for="RolId" class="form-control" asp-items="roles"></select>
                    </div>
                    <div class="form-group">
                        <label>@L["Adm_Plan"]</label>
                        <select asp-for="MembresiaId" class="form-control" asp-items="membresias">
                            <option value="">@L["Adm_NoPlan"]</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>@L["Adm_MembStart"]</label>
                        <input asp-for="MembresiaInicio" type="date" class="form-control" value="@(Model.MembresiaInicio?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="form-group">
                        <label>@L["Adm_MembEnd"]</label>
                        <input asp-for="MembresiaFin" type="date" class="form-control" value="@(Model.MembresiaFin?.ToString("yyyy-MM-dd"))" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>@L["Adm_NewPassword"]</label>
                        <input type="password" name="nuevaPassword" class="form-control" placeholder="@L["Adm_NewPasswordPh"]" />
                    </div>
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div style="display:flex;gap:18px;padding-top:8px">
                            <label style="font-weight:600"><input type="checkbox" asp-for="CorreoConfirmado" /> @L["Adm_Verified"]</label>
                            <label style="font-weight:600"><input type="checkbox" asp-for="Activo" /> @L["Adm_ActiveLbl"]</label>
                        </div>
                    </div>
                </div>

                <div style="display:flex;gap:10px;margin-top:8px">
                    <button type="submit" class="btn btn-primary">@L["Btn_Save"]</button>
                    <a class="btn btn-ghost" asp-action="Usuarios">@L["Btn_Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
