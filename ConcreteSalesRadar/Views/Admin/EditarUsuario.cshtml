@model Usuario
@{
    ViewData["Title"] = "Editar usuario";
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var membresias = ViewBag.Membresias as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}
<div class="app-main">
    <div class="container-xl">
        <h1 class="page-title">Editar usuario</h1>
        <p class="page-sub">@Model.Correo</p>

        <div class="card" style="max-width:720px">
            <form asp-action="EditarUsuario" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Correo" />
                <input type="hidden" asp-for="PasswordHash" />
                <input type="hidden" asp-for="FechaRegistro" />

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Nombre"></label>
                        <input asp-for="Nombre" class="form-control" maxlength="50" />
                        <span asp-validation-for="Nombre"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Apellido"></label>
                        <input asp-for="Apellido" class="form-control" maxlength="50" />
                        <span asp-validation-for="Apellido"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Compania">Compañía</label>
                        <input asp-for="Compania" class="form-control" maxlength="50" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Telefono">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" maxlength="50" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="RolId">Rol</label>
                        <select asp-for="RolId" class="form-control" asp-items="roles"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="MembresiaId">Membresía</label>
                        <select asp-for="MembresiaId" class="form-control" asp-items="membresias">
                            <option value="">— Sin membresía —</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Nueva contraseña (opcional)</label>
                        <input type="password" name="nuevaPassword" class="form-control" placeholder="Dejar en blanco para no cambiar" />
                    </div>
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div style="display:flex;gap:18px;padding-top:8px">
                            <label style="font-weight:600"><input type="checkbox" asp-for="CorreoConfirmado" /> Verificado</label>
                            <label style="font-weight:600"><input type="checkbox" asp-for="Activo" /> Activo</label>
                        </div>
                    </div>
                </div>

                <div style="display:flex;gap:10px;margin-top:8px">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a class="btn btn-ghost" asp-action="Usuarios">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
