@model List<Membresia>
@{
    ViewData["Title"] = "Concrete Sales Radar";
}

<!-- HERO -->
<header class="hero">
    <div class="container-xl">
        <div class="hero-grid">
            <div>
                <h1>@L["Hero_Title1"]<span class="accent">@L["Hero_Title2"]</span></h1>
                <p class="lead">@L["Hero_Lead"]</p>
                <div class="hero-checks">
                    <span><span class="dot">✓</span> @L["Hero_Check1"]</span>
                    <span><span class="dot">✓</span> @L["Hero_Check2"]</span>
                    <span><span class="dot">✓</span> @L["Hero_Check3"]</span>
                    <span><span class="dot">✓</span> @L["Hero_Check4"]</span>
                </div>
                <div class="hero-cta">
                    <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Registro">@L["Hero_CTA_Start"]</a>
                    <a class="btn btn-outline" href="#how">@L["Hero_CTA_How"]</a>
                </div>
                <div class="hero-note">@L["Hero_Note"]</div>
            </div>
            <div class="hero-img">
                <div>
                    <div class="truck">🚛</div>
                    <h3 style="margin:10px 0 4px">North Texas Ready-Mix</h3>
                    <p style="opacity:.85;margin:0">@L["Hero_CardSub"]</p>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- AUDIENCE -->
<div class="audience">
    <div class="container-xl">
        <div class="audience-grid">
            <div class="audience-item"><div class="ico">🚛</div><div>@L["Aud_1"]</div></div>
            <div class="audience-item"><div class="ico">👷</div><div>@L["Aud_2"]</div></div>
            <div class="audience-item"><div class="ico">🏢</div><div>@L["Aud_3"]</div></div>
            <div class="audience-item"><div class="ico">⛽</div><div>@L["Aud_4"]</div></div>
            <div class="audience-item"><div class="ico">⛰️</div><div>@L["Aud_5"]</div></div>
            <div class="audience-item"><div class="ico">📈</div><div>@L["Aud_6"]</div></div>
        </div>
    </div>
</div>

<!-- HOW IT WORKS -->
<section id="how">
    <div class="container-xl">
        <div class="section-head">
            <h2>@L["How_Title"]</h2>
            <p>@L["How_Sub"]</p>
        </div>
        <div class="how-grid">
            <div>
                <div class="step"><div class="num">1</div><div><h4>@L["How_Step1_T"]</h4><p>@L["How_Step1_D"]</p></div></div>
                <div class="step"><div class="num">2</div><div><h4>@L["How_Step2_T"]</h4><p>@L["How_Step2_D"]</p></div></div>
                <div class="step"><div class="num">3</div><div><h4>@L["How_Step3_T"]</h4><p>@L["How_Step3_D"]</p></div></div>
                <div class="step"><div class="num">4</div><div><h4>@L["How_Step4_T"]</h4><p>@L["How_Step4_D"]</p></div></div>
                <div class="step"><div class="num">5</div><div><h4>@L["How_Step5_T"]</h4><p>@L["How_Step5_D"]</p></div></div>
            </div>
            <div class="mock">
                <div class="mock-head">◎ Concrete Sales Radar — @L["Nav_Dashboard"]</div>
                <div class="mock-body">
                    <div class="kpis" style="margin:0">
                        <div class="kpi"><strong>124</strong><span>@L["Mock_KPI1"]</span></div>
                        <div class="kpi"><strong>$2.4B</strong><span>@L["Mock_KPI2"]</span></div>
                        <div class="kpi"><strong>285K</strong><span>@L["Mock_KPI3"]</span></div>
                    </div>
                    <p class="muted" style="margin-top:14px;font-size:13px">@L["Mock_Text"]</p>
                    <a class="btn btn-primary btn-sm" asp-controller="Cuenta" asp-action="Registro">@L["Mock_Btn"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PRICING -->
<section id="pricing" class="pricing">
    <div class="container-xl">
        <div class="section-head">
            <h2>@L["Pricing_Title"]</h2>
            <p>@L["Pricing_Sub"]</p>
        </div>
        <div id="features" class="price-grid">
            @foreach (var plan in Model)
            {
                <div class="price-card @(plan.EsPopular ? "popular" : "")">
                    @if (plan.EsPopular)
                    {
                        <div class="price-tag">@L["Pricing_Popular"]</div>
                    }
                    <h3>@plan.Nombre</h3>
                    @if (plan.PrecioMensual > 0)
                    {
                        <div class="price-amount">$@plan.PrecioMensual.ToString("0") <small>@L["Pricing_PerMonth"]</small></div>
                    }
                    else
                    {
                        <div class="price-contact">@L["Pricing_Contact"]</div>
                    }
                    <ul class="feature-list">
                        @foreach (var c in (plan.Caracteristicas ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li>@c.Trim()</li>
                        }
                    </ul>
                    @if (plan.PrecioMensual > 0)
                    {
                        <a class="btn btn-primary btn-block" asp-controller="Cuenta" asp-action="Registro" asp-route-plan="@plan.Id">@L["Hero_CTA_Start"]</a>
                    }
                    else
                    {
                        <a class="btn btn-outline btn-block" asp-controller="Cuenta" asp-action="Registro" asp-route-plan="@plan.Id">@L["Pricing_Contact"]</a>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- VALUE PROPS -->
<section>
    <div class="container-xl">
        <div class="values">
            <div class="value-item"><div class="ico">📈</div><h4>@L["Val1_T"]</h4><p>@L["Val1_D"]</p></div>
            <div class="value-item"><div class="ico">🎯</div><h4>@L["Val2_T"]</h4><p>@L["Val2_D"]</p></div>
            <div class="value-item"><div class="ico">💲</div><h4>@L["Val3_T"]</h4><p>@L["Val3_D"]</p></div>
            <div class="value-item"><div class="ico">🤝</div><h4>@L["Val4_T"]</h4><p>@L["Val4_D"]</p></div>
        </div>
    </div>
</section>

<!-- CTA -->
<div class="cta-band">
    <div class="container-xl">
        <div class="inner">
            <div>
                <h3>@L["CTA_Title"]</h3>
                <p>@L["CTA_Sub"]</p>
            </div>
            <a class="btn btn-white" asp-controller="Cuenta" asp-action="Registro">@L["CTA_Btn"]</a>
        </div>
    </div>
</div>
