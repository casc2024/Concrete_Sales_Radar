@using ConcreteSalesRadar.Helpers
@model DashboardViewModel
@{
    ViewData["Title"] = L["Dash_Title"].Value;
    string AgeLabel(int? meses) =>
        meses is null ? L["Age_NA"].Value
        : meses < 0 ? L["Age_Upcoming"].Value
        : $"{meses} {(meses == 1 ? L["Age_Month"].Value : L["Age_Months"].Value)}";
}

<div class="app-main">
    <div class="container-xl">
        <h1 class="page-title">@L["Dash_Title"]</h1>
        <p class="page-sub">@L["Dash_Sub"]</p>

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">@TempData["Exito"]</div>
        }

        <!-- Búsqueda -->
        <div class="card">
            <h3 class="card-title">@L["Dash_SearchTitle"]</h3>
            <form asp-action="Index" method="get" id="filtros">
                <div class="search-grid">
                    <div>
                        <label>@L["Dash_Zone"]</label>
                        <input class="form-control" name="Zona" value="@Model.Zona" placeholder="Ponder, TX / 76259" />
                    </div>
                    <div>
                        <label>@L["Dash_BudgetMin"]</label>
                        <select class="form-control" name="PresupuestoMin">
                            @{
                                var montos = new (decimal v, string t)[] { (0, L["Dash_NoMin"].Value), (1000000, "$1M+"), (5000000, "$5M+"), (10000000, "$10M+"), (25000000, "$25M+"), (50000000, "$50M+") };
                            }
                            @foreach (var m in montos)
                            {
                                <option value="@m.v" selected="@(Model.PresupuestoMin == m.v)">@m.t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>@L["Dash_Type"]</label>
                        <select class="form-control" name="Tipo">
                            <option value="">@L["Dash_All"]</option>
                            @foreach (var t in DashboardViewModel.TiposObra)
                            {
                                <option value="@t" selected="@(Model.Tipo == t)">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>@L["Dash_Age"]</label>
                        <select class="form-control" name="Antiguedad">
                            <option value="">@L["Dash_AnyAge"]</option>
                            <option value="new" selected="@(Model.Antiguedad == "new")">@L["Dash_Age1"]</option>
                            <option value="active" selected="@(Model.Antiguedad == "active")">@L["Dash_Age2"]</option>
                            <option value="mature" selected="@(Model.Antiguedad == "mature")">@L["Dash_Age3"]</option>
                        </select>
                    </div>
                    <div>
                        <label>&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block">@L["Dash_SearchBtn"]</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- KPIs -->
        <div class="kpis">
            <div class="kpi"><strong>@Formato.Numero(Model.TotalObras)</strong><span>@L["Dash_KPI_Projects"]</span></div>
            <div class="kpi"><strong>@Formato.Dinero(Model.PresupuestoTotal)</strong><span>@L["Dash_KPI_Budget"]</span></div>
            <div class="kpi"><strong>@Formato.Numero(Model.YardasTotal)</strong><span>@L["Dash_KPI_Yards"]</span></div>
            <div class="kpi"><strong>@Model.Calientes</strong><span>@L["Dash_KPI_Hot"]</span></div>
            <div class="kpi"><strong>@Model.ConContacto</strong><span>@L["Dash_KPI_Contact"]</span></div>
        </div>

        <!-- Pipeline -->
        <div class="grid2">
            <div class="card">
                <h3 class="card-title">@L["Dash_PipelineType"]</h3>
                @if (Model.PorTipo.Any())
                {
                    foreach (var t in Model.PorTipo)
                    {
                        <p style="margin:6px 0"><b>@t.Tipo</b> <span class="muted">(@t.Cantidad)</span></p>
                    }
                }
                else
                {
                    <span class="muted">@L["Dash_NoData"]</span>
                }
            </div>
            <div class="card">
                <h3 class="card-title">@L["Dash_Priority"]</h3>
                <p style="margin:6px 0"><b>@L["Dash_PrioHigh"]:</b> @Model.PrioridadAlta</p>
                <p style="margin:6px 0"><b>@L["Dash_PrioMid"]:</b> @Model.PrioridadMedia</p>
                <p style="margin:6px 0"><b>@L["Dash_PrioLow"]:</b> @Model.PrioridadBaja</p>
            </div>
        </div>

        <!-- Tabla -->
        <div class="card">
            <form asp-action="Index" method="get" class="toolbar">
                <input type="hidden" name="Zona" value="@Model.Zona" />
                <input type="hidden" name="Tipo" value="@Model.Tipo" />
                <input type="hidden" name="PresupuestoMin" value="@Model.PresupuestoMin" />
                <input type="hidden" name="Antiguedad" value="@Model.Antiguedad" />
                <input class="form-control" name="Busqueda" value="@Model.Busqueda" placeholder="@L["Dash_SearchPlaceholder"]" />
                <select class="form-control" name="Contacto" onchange="this.form.submit()">
                    <option value="">@L["Dash_ContactAll"]</option>
                    <option value="yes" selected="@(Model.Contacto == "yes")">@L["Dash_ContactYes"]</option>
                    <option value="no" selected="@(Model.Contacto == "no")">@L["Dash_ContactNo"]</option>
                </select>
                <button type="submit" class="btn btn-ghost">@L["Dash_Filter"]</button>
                <span></span>
                <a class="btn btn-primary" asp-action="Crear">@L["Dash_AddProject"]</a>
            </form>

            <div class="tablewrap">
                <table class="data">
                    <thead>
                        <tr>
                            @if (Model.Ver("prioridad")) { <th>@L["Col_Priority"]</th> }
                            @if (Model.Ver("direccion")) { <th>@L["Col_Address"]</th> }
                            @if (Model.Ver("proyecto")) { <th>@L["Col_Project"]</th> }
                            @if (Model.Ver("tipo")) { <th>@L["Col_Type"]</th> }
                            @if (Model.Ver("antiguedad")) { <th>@L["Col_Age"]</th> }
                            @if (Model.Ver("presupuesto")) { <th>@L["Col_Budget"]</th> }
                            @if (Model.Ver("yardas")) { <th>@L["Col_Yards"]</th> }
                            @if (Model.Ver("empresa")) { <th>@L["Col_ContactCompany"]</th> }
                            @if (Model.Ver("nombre")) { <th>@L["Col_Name"]</th> }
                            @if (Model.Ver("email")) { <th>@L["Col_Email"]</th> }
                            @if (Model.Ver("telefono")) { <th>@L["Col_PhoneDirect"]</th> }
                            @if (Model.Ver("telefonoEmpresa")) { <th>@L["Col_PhoneCompany"]</th> }
                            @if (Model.Ver("fuente")) { <th>@L["Col_Source"]</th> }
                            <th>@L["Col_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Proyectos)
                        {
                            var age = Formato.Antiguedad(p.FechaInicio);
                            <tr>
                                @if (Model.Ver("prioridad")) { <td><span class="badge @Formato.Calor(p.Prioridad)">@p.Prioridad / 100</span></td> }
                                @if (Model.Ver("direccion")) { <td>@(p.Direccion ?? "-")</td> }
                                @if (Model.Ver("proyecto")) { <td><b>@p.NombreProyecto</b></td> }
                                @if (Model.Ver("tipo")) { <td>@(p.Tipo ?? "-")</td> }
                                @if (Model.Ver("antiguedad")) { <td><span class="badge @age.Clase">@AgeLabel(age.Meses)</span></td> }
                                @if (Model.Ver("presupuesto")) { <td>@Formato.Dinero(p.Presupuesto)</td> }
                                @if (Model.Ver("yardas")) { <td><b>@Formato.Numero(p.Yardas)</b> yd³</td> }
                                @if (Model.Ver("empresa")) { <td>@(p.EmpresaContacto ?? "-")</td> }
                                @if (Model.Ver("nombre")) { <td>@(p.NombreContacto ?? "-")</td> }
                                @if (Model.Ver("email")) { <td>@if (!string.IsNullOrWhiteSpace(p.Email)) { <a href="mailto:@p.Email">@p.Email</a> } else { <text>-</text> }</td> }
                                @if (Model.Ver("telefono")) { <td>@if (!string.IsNullOrWhiteSpace(p.Telefono)) { <a href="tel:@p.Telefono">@p.Telefono</a> } else { <text>-</text> }</td> }
                                @if (Model.Ver("telefonoEmpresa")) { <td>@if (!string.IsNullOrWhiteSpace(p.TelefonoEmpresa)) { <a href="tel:@p.TelefonoEmpresa">@p.TelefonoEmpresa</a> } else { <text>-</text> }</td> }
                                @if (Model.Ver("fuente")) { <td>@(($"{p.Fuente}{(string.IsNullOrWhiteSpace(p.Nota) ? "" : " · " + p.Nota)}").Trim(' ', '·'))</td> }
                                <td class="actions-cell">
                                    <a class="btn btn-ghost btn-sm" asp-action="Editar" asp-route-id="@p.Id">@L["Act_Edit"]</a>
                                    <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" onsubmit="return confirm('@L["Confirm_DeleteProject"]');" style="margin:0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">X</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Proyectos.Any())
                {
                    <div class="empty">@L["Dash_Empty"]</div>
                }
            </div>

            @if (Model.TotalRegistros > 0)
            {
                var desde = (Model.Pagina - 1) * DashboardViewModel.TamanoPagina + 1;
                var hasta = Math.Min(Model.Pagina * DashboardViewModel.TamanoPagina, Model.TotalRegistros);
                var inicio = Math.Max(1, Model.Pagina - 2);
                var fin = Math.Min(Model.TotalPaginas, Model.Pagina + 2);
                <div class="pager">
                    <span class="pager-info">
                        @L["Page_Info", Model.Pagina, Model.TotalPaginas]
                        <span class="muted">· @desde–@hasta / @Model.TotalRegistros</span>
                    </span>
                    <div class="pager-links">
                        @if (Model.Pagina > 1)
                        {
                            <a class="page-link" asp-action="Index"
                               asp-route-Zona="@Model.Zona" asp-route-Tipo="@Model.Tipo"
                               asp-route-PresupuestoMin="@Model.PresupuestoMin" asp-route-Antiguedad="@Model.Antiguedad"
                               asp-route-Busqueda="@Model.Busqueda" asp-route-Contacto="@Model.Contacto"
                               asp-route-pagina="@(Model.Pagina - 1)">‹ @L["Page_Prev"]</a>
                        }
                        else
                        {
                            <span class="page-link disabled">‹ @L["Page_Prev"]</span>
                        }

                        @for (var i = inicio; i <= fin; i++)
                        {
                            if (i == Model.Pagina)
                            {
                                <span class="page-link active">@i</span>
                            }
                            else
                            {
                                <a class="page-link" asp-action="Index"
                                   asp-route-Zona="@Model.Zona" asp-route-Tipo="@Model.Tipo"
                                   asp-route-PresupuestoMin="@Model.PresupuestoMin" asp-route-Antiguedad="@Model.Antiguedad"
                                   asp-route-Busqueda="@Model.Busqueda" asp-route-Contacto="@Model.Contacto"
                                   asp-route-pagina="@i">@i</a>
                            }
                        }

                        @if (Model.Pagina < Model.TotalPaginas)
                        {
                            <a class="page-link" asp-action="Index"
                               asp-route-Zona="@Model.Zona" asp-route-Tipo="@Model.Tipo"
                               asp-route-PresupuestoMin="@Model.PresupuestoMin" asp-route-Antiguedad="@Model.Antiguedad"
                               asp-route-Busqueda="@Model.Busqueda" asp-route-Contacto="@Model.Contacto"
                               asp-route-pagina="@(Model.Pagina + 1)">@L["Page_Next"] ›</a>
                        }
                        else
                        {
                            <span class="page-link disabled">@L["Page_Next"] ›</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
