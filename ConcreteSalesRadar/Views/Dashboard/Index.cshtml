@using ConcreteSalesRadar.Helpers
@model DashboardViewModel
@{
    ViewData["Title"] = L["Dash_Title"].Value;
}

<div class="app-main">
    <div class="container-xl">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <div>
                <h1 class="page-title">@L["Dash_Title"]</h1>
                <p class="page-sub">@L["Dash_Sub"]</p>
            </div>
            @if (User.IsInRole("Administrador"))
            {
                <a id="btnExportarExcel" class="btn btn-ghost" style="display:flex;align-items:center;gap:8px;white-space:nowrap"
                   asp-action="ExportarExcel"
                   asp-route-Zona="@Model.Zona" asp-route-Tipo="@Model.Tipo"
                   asp-route-PresupuestoMin="@Model.PresupuestoMin" asp-route-Antiguedad="@Model.Antiguedad"
                   title="Exportar a Excel">
                    <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect x="2" y="4" width="44" height="40" rx="5" fill="#1D6F42"></rect>
                        <rect x="7" y="9" width="34" height="30" rx="2" fill="#ffffff"></rect>
                        <path d="M14 15 L20.5 24 L14 33 H18.3 L22.5 26.7 L26.7 33 H31 L24.5 24 L31 15 H26.7 L22.5 21.3 L18.3 15 Z" fill="#1D6F42"></path>
                    </svg>
                    <span>Exportar a Excel</span>
                </a>
            }
        </div>

        <div id="alerta">
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success">@TempData["Exito"]</div>
            }
        </div>

        <!-- Búsqueda -->
        <div class="card">
            <h3 class="card-title">@L["Dash_SearchTitle"]</h3>
            <form asp-action="Index" method="get" id="filtros">
                <div class="search-grid">
                    <div>
                        <label>@L["Dash_Zone"]</label>
                        <input class="form-control" name="Zona" value="@Model.Zona" placeholder="Ciudad, área, ZIP o dirección (ej. Dallas · 75234 · W 7th St)" />
                    </div>
                    <div>
                        <label>@L["Dash_BudgetMin"]</label>
                        <select class="form-control" name="PresupuestoMin">
                            @{
                                var montos = new (decimal v, string t)[] { (0, L["Dash_NoMin"].Value), (1000000, "$1M+"), (5000000, "$5M+"), (10000000, "$10M+"), (25000000, "$25M+"), (50000000, "$50M+") };
                            }
                            @foreach (var m in montos)
                            {
                                <option value="@m.v" selected="@(Model.PresupuestoMin == m.v)">@m.t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>@L["Dash_Type"]</label>
                        <select class="form-control" name="Tipo">
                            <option value="">@L["Dash_All"]</option>
                            @foreach (var t in DashboardViewModel.TiposObra)
                            {
                                <option value="@t" selected="@(Model.Tipo == t)">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>@L["Dash_Age"]</label>
                        <select class="form-control" name="Antiguedad">
                            <option value="">@L["Dash_AnyAge"]</option>
                            <option value="new" selected="@(Model.Antiguedad == "new")">@L["Dash_Age1"]</option>
                            <option value="active" selected="@(Model.Antiguedad == "active")">@L["Dash_Age2"]</option>
                            <option value="mature" selected="@(Model.Antiguedad == "mature")">@L["Dash_Age3"]</option>
                        </select>
                    </div>
                    <div>
                        <label>&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block">@L["Dash_SearchBtn"]</button>
                    </div>
                </div>
            </form>
        </div>

        <div id="resultados">
            @await Html.PartialAsync("_ResultadosDashboard", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('filtros');
            var resultados = document.getElementById('resultados');
            var exportBtn = document.getElementById('btnExportarExcel');

            // Carga resultados por AJAX: solo reemplaza el fragmento (KPIs + pipeline + tabla),
            // sin navegar ni recargar la página completa (evita el salto al inicio y reduce
            // el payload transferido frente a una recarga de toda la página).
            function cargar(url, actualizarHistorial) {
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        resultados.innerHTML = html;
                        if (actualizarHistorial !== false) {
                            window.history.pushState({ csrUrl: url }, '', url);
                        }
                        if (exportBtn) actualizarEnlaceExportar(url);
                    })
                    .catch(function () {
                        // Si algo falla (red, etc.), caer a navegación normal.
                        window.location.href = url;
                    });
            }

            // El export siempre debe reflejar los filtros actuales, aunque se haya buscado por AJAX.
            function actualizarEnlaceExportar(urlIndex) {
                try {
                    var params = new URL(urlIndex, window.location.origin).searchParams;
                    var exportUrl = new URL(exportBtn.href, window.location.origin);
                    ['Zona', 'Tipo', 'PresupuestoMin', 'Antiguedad'].forEach(function (k) {
                        if (params.has(k)) exportUrl.searchParams.set(k, params.get(k));
                        else exportUrl.searchParams.delete(k);
                    });
                    exportBtn.href = exportUrl.pathname + exportUrl.search;
                } catch (e) { /* no crítico */ }
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var params = new URLSearchParams(new FormData(form));
                    // Nueva búsqueda: reinicia a la página 1.
                    params.delete('pagina');
                    cargar(form.getAttribute('action') + '?' + params.toString(), true);
                });
            }

            // Delegación de eventos: los enlaces de paginación se reemplazan junto con el
            // fragmento, así que el listener va en un contenedor estable (resultados).
            resultados.addEventListener('click', function (e) {
                var link = e.target.closest('a.page-link');
                if (!link || link.classList.contains('disabled')) return;
                e.preventDefault();
                cargar(link.getAttribute('href'), true);
            });

            // Atrás/Adelante del navegador: vuelve a pedir el fragmento para esa URL.
            window.addEventListener('popstate', function () {
                cargar(window.location.href, false);
            });
        })();
    </script>
}
