@using System.Security.Claims
@using System.Globalization
@{
    var esAdmin = User.IsInRole(Roles.Administrador);
    var autenticado = User.Identity?.IsAuthenticated ?? false;
    var nombre = User.FindFirstValue(ClaimTypes.Name);
    var culturaActual = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var idiomas = new[] { ("es", "ES"), ("en", "EN"), ("pt", "PT") };
}
<!DOCTYPE html>
<html lang="@culturaActual">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Concrete Sales Radar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="topnav">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="logo">◎</span>
            <span class="name"><b>CONCRETE</b><span>SALES RADAR</span></span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="hamburger" aria-label="@L["Lang_Language"]">
            <span></span><span></span><span></span>
        </label>
        <div class="nav-collapse">
            <div class="navlinks">
                <a asp-controller="Home" asp-action="Index">@L["Nav_Home"]</a>
                <a href="/#features">@L["Nav_Features"]</a>
                <a href="/#pricing">@L["Nav_Pricing"]</a>
                @if (autenticado)
                {
                    <a asp-controller="Dashboard" asp-action="Index">@L["Nav_Dashboard"]</a>
                }
                @if (esAdmin)
                {
                    <a asp-controller="Admin" asp-action="Index">@L["Nav_Admin"]</a>
                }
            </div>
            <div class="navactions">
                <div class="lang-switch" title="@L["Lang_Language"]">
                    @foreach (var (code, label) in idiomas)
                    {
                        <form asp-controller="Home" asp-action="CambiarIdioma" method="post">
                            <input type="hidden" name="cultura" value="@code" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="lang-btn @(culturaActual == code ? "active" : "")">@label</button>
                        </form>
                    }
                </div>
                @if (autenticado)
                {
                    <span class="muted hello" style="font-size:13px">@L["Nav_Hello"], @nombre</span>
                    <form asp-controller="Cuenta" asp-action="Logout" method="post" style="margin:0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm">@L["Nav_Logout"]</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline btn-sm" asp-controller="Cuenta" asp-action="Login">@L["Nav_Login"]</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Cuenta" asp-action="Registro">@L["Nav_FreeTrial"]</a>
                }
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="site">
        <div class="container-xl" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px">
            <div>© @DateTime.Now.Year Concrete Sales Radar — @L["Footer_Text"]</div>
            <div><a asp-controller="Home" asp-action="Privacy">@L["Footer_Privacy"]</a></div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
